{
  "permissions": {
    "allow": [
      "Bash(npx vitest *)",
      "Bash(node *)"
    ]
  },
  "hooks": {
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.fina/hooks/fina-session-start.sh",
            "timeout": 10,
            "statusMessage": "Re-orienting after compaction..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.fina/hooks/fina-post-commit.sh",
            "if": "Bash(git commit*)",
            "timeout": 10,
            "statusMessage": "Recording milestone..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.fina/hooks/fina-pre-compact.sh",
            "timeout": 10,
            "statusMessage": "Saving session baton before compaction..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.fina/hooks/fina-pre-read.sh",
            "timeout": 5,
            "statusMessage": "Checking Fina knowledge..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.fina/hooks/fina-pre-pr.sh",
            "if": "Bash(gh pr create*)",
            "timeout": 10,
            "statusMessage": "Preparing work summary..."
          }
        ]
      },
      {
        "matcher": "mcp__DAST-Orch__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "~/.fina/hooks/fina-pre-pr.sh",
            "timeout": 10,
            "statusMessage": "Preparing work summary..."
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.fina/hooks/fina-pre-tool-use.sh",
            "timeout": 10,
            "statusMessage": "Heartbeating session..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.fina/hooks/fina-session-end.sh",
            "timeout": 10,
            "statusMessage": "Closing Fina session..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.fina/hooks/fina-session-start.sh",
            "timeout": 10,
            "statusMessage": "Loading project context from Fina..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.fina/hooks/fina-stop.sh",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
