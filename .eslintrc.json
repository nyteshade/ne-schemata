{
  "env": {
    "node": true,
    "es2022": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "root": true,
  "rules": {
    "brace-style": [1, "stroustrup", { "allowSingleLine": true }],
    "indent": [1, 2]
  }
}
